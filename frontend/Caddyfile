luzcoletiva.com.br {
    tls /etc/caddy/certs/origin.crt /etc/caddy/certs/origin.key

    encode gzip zstd

    handle /api/* {
        reverse_proxy backend:8000
    }

    handle {
        root * /usr/share/caddy
        try_files {path} /index.html
        file_server
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://www.google-analytics.com https://www.googletagmanager.com; font-src 'self'; connect-src 'self' https://www.google-analytics.com https://*.analytics.google.com https://*.g.doubleclick.net; object-src 'none'; base-uri 'self'; frame-ancestors 'none';"
        -Server
    }
}

www.luzcoletiva.com.br {
    tls /etc/caddy/certs/origin.crt /etc/caddy/certs/origin.key
    redir https://luzcoletiva.com.br{uri} permanent
}
