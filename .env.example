# ===== Luz Coletiva — Variáveis de ambiente =====
# Copie este arquivo para .env e ajuste antes de subir os containers.

# Aplicação
DEBUG=true

# Banco de dados (PostgreSQL)
POSTGRES_USER=luzcoletiva
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=luzcoletiva
DATABASE_URL=postgresql+psycopg2://luzcoletiva:troque-esta-senha@db:5432/luzcoletiva

# Segurança JWT
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=GERE-UM-SEGREDO-FORTE-AQUI-NUNCA-COMMITAR
JWT_EXPIRES_MIN=60

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# SMTP — em dev, deixe vazio (e-mails apenas logados)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@luzcoletiva.com.br

# E-mail de destino para alertas do sistema (falhas de backup, erros críticos)
ALERT_EMAIL=contato@luzcoletiva.com.br

# CORS — domínios permitidos (separados por vírgula)
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:3000
